page {
    min-height: 100%;
    background: #faf9f4;
    color: #2b2620;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

button {
    border-radius: 12rpx;
}

/* 通用状态 */
.state-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 120rpx 40rpx;
}

.state-text {
    font-size: 28rpx;
    color: #a89f94;
}

/* 卡片 */
.card {
    background: #ffffff;
    border-radius: 24rpx;
    box-shadow: 0 6rpx 24rpx rgba(150, 110, 20, 0.07);
}

/* 主按钮 */
.btn-primary {
    height: 88rpx;
    line-height: 88rpx;
    font-size: 30rpx;
    font-weight: 600;
    color: #4a3a00;
    background: #f7b500;
    border-radius: 20rpx;
}

.btn-primary::after {
    border: none;
}

.btn-primary[disabled] {
    color: #4a3a00;
    background: #f8d777;
}

.btn-ghost {
    height: 88rpx;
    line-height: 88rpx;
    font-size: 30rpx;
    font-weight: 500;
    color: #6b6155;
    background: #f1ede3;
    border-radius: 20rpx;
}

.btn-ghost::after {
    border: none;
}

.btn-danger {
    height: 88rpx;
    line-height: 88rpx;
    font-size: 30rpx;
    color: #c2410c;
    background: #ffedd5;
    border-radius: 20rpx;
}

.btn-danger::after {
    border: none;
}

/* 表单 */
.form-card {
    padding: 32rpx 28rpx;
}

.form-item {
    margin-bottom: 32rpx;
}

.form-label {
    display: block;
    margin-bottom: 14rpx;
    font-size: 26rpx;
    font-weight: 600;
    color: #6b6155;
}

.form-label .optional {
    font-weight: 400;
    color: #b3a996;
}

.form-input {
    height: 84rpx;
    padding: 0 24rpx;
    font-size: 28rpx;
    background: #f6f3ea;
    border-radius: 18rpx;
}

.form-textarea {
    width: auto;
    height: 160rpx;
    padding: 20rpx 24rpx;
    font-size: 28rpx;
    background: #f6f3ea;
    border-radius: 18rpx;
}

.picker-value {
    height: 84rpx;
    line-height: 84rpx;
    padding: 0 24rpx;
    font-size: 28rpx;
    background: #f6f3ea;
    border-radius: 18rpx;
}

.picker-placeholder {
    color: #b3a996;
}

.form-error {
    display: block;
    margin: -12rpx 0 24rpx;
    font-size: 24rpx;
    color: #c2410c;
}

/* 状态标签 */
.chip {
    flex-shrink: 0;
    padding: 6rpx 18rpx;
    font-size: 22rpx;
    border-radius: 999rpx;
}

.chip-pending {
    color: #92400e;
    background: #fef3c7;
}

.chip-accepted {
    color: #9a3412;
    background: #ffedd5;
}

.chip-deposit {
    color: #1d4ed8;
    background: #dbeafe;
}

.chip-completed {
    color: #7c2d12;
    background: #fee2e2;
}

.chip-finished {
    color: #166534;
    background: #dcfce7;
}

.chip-cancelled {
    color: #6b7280;
    background: #f3f4f6;
}

/* 列表卡片通用行 */
.list-card {
    padding: 26rpx;
    margin-bottom: 20rpx;
}

.row-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.row-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #2b2620;
}

.row-sub {
    display: block;
    margin-top: 10rpx;
    font-size: 26rpx;
    color: #6b6155;
}

.row-meta {
    display: block;
    margin-top: 8rpx;
    font-size: 23rpx;
    color: #b3a996;
}

/* 首次使用（身份引导） */
.onboard-wrap {
    padding: 60rpx 40rpx 80rpx;
}

.brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 44rpx;
}

.brand-emoji {
    font-size: 96rpx;
    line-height: 1.2;
}

.brand-title {
    margin-top: 16rpx;
    font-size: 40rpx;
    font-weight: 700;
    color: #2b2620;
}

.brand-desc {
    margin-top: 10rpx;
    font-size: 26rpx;
    color: #a89f94;
}

.role-row {
    display: flex;
    margin: 32rpx 0 8rpx;
}

.role-option {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 36rpx 0;
    background: #ffffff;
    border: 4rpx solid #efe9da;
    border-radius: 24rpx;
}

.role-option-active {
    border-color: #f7b500;
    background: #fffbea;
}

.role-icon {
    font-size: 64rpx;
}

.role-name {
    margin-top: 12rpx;
    font-size: 30rpx;
    font-weight: 600;
    color: #2b2620;
}

.role-desc {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #a89f94;
}

/* 工作台标题 */
.role-bar {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 88rpx;
    padding: 0 26rpx;
    margin-bottom: 24rpx;
    background: #ffffff;
    border-radius: 20rpx;
    box-shadow: 0 4rpx 16rpx rgba(150, 110, 20, 0.09);
}

/* 评分与评价 */
.star-row {
    display: flex;
    margin: 16rpx 0 20rpx;
}

.star {
    font-size: 52rpx;
    line-height: 1;
    color: #d9d2c4;
    margin-right: 20rpx;
}

.star-active {
    color: #f7b500;
}

.review-stars-text {
    font-size: 24rpx;
    color: #c78d00;
    flex-shrink: 0;
}

.review-item {
    padding: 18rpx 0 4rpx;
}

.review-item + .review-item {
    border-top: 2rpx solid #f1ede3;
    margin-top: 14rpx;
    padding-top: 18rpx;
}

.review-comment {
    margin-bottom: 20rpx;
}

.rating-meta {
    color: #c78d00;
}

/* 订单详情：联系方式与过期提示 */
.contact-call-btn {
    margin-top: 20rpx;
}

.expired-hint {
    display: block;
    margin-top: 16rpx;
    font-size: 24rpx;
    color: #b45309;
    text-align: center;
}

/* 服务地点 */
.location-value {
    position: relative;
}

.location-address {
    display: block;
    margin-top: 8rpx;
}

.location-clear {
    display: inline-block;
    margin-top: 10rpx;
    font-size: 24rpx;
    color: #c78d00;
}

.map-link {
    font-size: 24rpx;
    color: #1d4ed8;
    flex-shrink: 0;
}

/* 收藏 */
.price-fav {
    display: flex;
    align-items: center;
    flex-shrink: 0;
}

.fav-heart {
    margin-left: 16rpx;
    font-size: 40rpx;
    line-height: 1;
    color: #d9d2c4;
}

.fav-on {
    color: #e11d48;
}

.fav-filter {
    display: inline-block;
    padding: 8rpx 24rpx;
    border: 2rpx solid #efe9da;
    border-radius: 999rpx;
}

.fav-filter-text {
    font-size: 24rpx;
    color: #8a7f6d;
}

.fav-filter-on {
    color: #e11d48;
    font-weight: 600;
}

/* 收入页结算按钮与联系方式操作行 */
.settle-btn {
    margin-top: 24rpx;
}

.contact-actions {
    margin-top: 20rpx;
    align-items: center;
}

.contact-actions .contact-call-btn {
    margin-top: 0;
    margin-right: 24rpx;
    flex: 1;
}

/* 技能标签 */
.skill-group-name {
    display: block;
    margin: 16rpx 0 10rpx;
    font-size: 22rpx;
    color: #a89f94;
}

.skill-tags {
    display: flex;
    flex-wrap: wrap;
}

.skill-tag {
    padding: 10rpx 26rpx;
    margin: 0 14rpx 14rpx 0;
    font-size: 24rpx;
    color: #6b6155;
    background: #f1ede3;
    border-radius: 999rpx;
}

.skill-tag-on {
    color: #4a3a00;
    background: #f7b500;
    font-weight: 600;
}

.skill-tags-static {
    margin-top: 14rpx;
}

.skill-tag-static {
    padding: 8rpx 22rpx;
    margin: 0 12rpx 10rpx 0;
    background: #fff8e1;
    color: #7a5c00;
}

.skill-clear {
    font-size: 24rpx;
    color: #c78d00;
    flex-shrink: 0;
}

.match-text {
    color: #c78d00;
    font-weight: 600;
}
