.main {
    padding: 28rpx 32rpx 60rpx;
}

.state-retry {
    margin-top: 28rpx;
    padding: 0 44rpx;
    height: 72rpx;
    line-height: 72rpx;
    font-size: 26rpx;
    color: #c78d00;
    background: #fff3c4;
    border-radius: 36rpx;
}

.summary-card {
    display: flex;
    flex-direction: column;
    padding: 36rpx 32rpx 28rpx;
    background: linear-gradient(135deg, #fff7da 0%, #ffffff 62%);
}

.summary-label {
    font-size: 26rpx;
    color: #8a7f6d;
}

.summary-amount {
    display: flex;
    align-items: flex-end;
    margin-top: 12rpx;
}

.summary-unit {
    margin-right: 6rpx;
    margin-bottom: 8rpx;
    font-size: 30rpx;
    font-weight: 600;
    color: #c78d00;
}

.summary-num {
    font-size: 76rpx;
    font-weight: 700;
    line-height: 1;
    color: #c78d00;
}

.summary-sub {
    margin-top: 12rpx;
    font-size: 24rpx;
    color: #a89f94;
}

.summary-split {
    height: 2rpx;
    margin: 26rpx 0 20rpx;
    background: #f0e8d4;
}

.summary-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.summary-row-label {
    font-size: 26rpx;
    color: #8a7f6d;
}

.summary-row-value {
    font-size: 28rpx;
    font-weight: 600;
    color: #92400e;
}

.income-amount {
    font-size: 28rpx;
    font-weight: 700;
    color: #166534;
}
