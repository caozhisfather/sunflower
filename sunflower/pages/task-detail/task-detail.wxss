.main {
    padding: 28rpx 32rpx 60rpx;
}

.detail-label {
    display: block;
    font-size: 25rpx;
    color: #a89f94;
}

.detail-text {
    display: block;
    margin-top: 12rpx;
    font-size: 28rpx;
    line-height: 1.7;
    color: #2b2620;
}

.detail-strong {
    font-size: 30rpx;
    font-weight: 700;
    color: #2b2620;
}

.price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12rpx 0;
}

.action-gap {
    margin-top: 24rpx;
}
