<view wx:if="{{forbidden}}" class="state-wrap">
    <text class="state-text">无权查看该预约（仅派单译员可操作）</text>
</view>

<view wx:elif="{{!order}}" class="state-wrap">
    <text class="state-text">订单不存在或已被删除</text>
</view>

<view wx:else class="main">
    <view class="card list-card">
        <view class="row-top">
            <text class="row-title">{{order.businessName}}</text>
            <text class="chip chip-{{order.status}}">{{statusLabel}}</text>
        </view>
        <text class="row-sub">{{dateLabel}} {{order.startTime}}</text>
        <text class="row-meta">预约编号 #{{order.id}}</text>
    </view>

    <view class="card list-card">
        <text class="detail-label">服务需求</text>
        <text class="detail-text">{{order.requirements || '商家未填写具体需求'}}</text>
    </view>

    <view wx:if="{{requiredTags.length > 0}}" class="card list-card">
        <view class="row-top">
            <text class="detail-label">需求技能</text>
            <text wx:if="{{match >= 0}}" class="chip {{matchClass}}">🎯 匹配 {{match}}%</text>
        </view>
        <view class="skill-tags skill-tags-static">
            <text wx:for="{{requiredTags}}" wx:key="*this" class="skill-tag skill-tag-static">{{item}}</text>
        </view>
    </view>

    <view wx:if="{{order.locationName}}" class="card list-card">
        <view class="row-top">
            <text class="detail-label">服务地点</text>
            <text class="map-link" bindtap="openLocation">打开地图 ›</text>
        </view>
        <text class="detail-text">{{order.locationName}}</text>
        <text wx:if="{{order.locationAddress}}" class="row-meta">{{order.locationAddress}}</text>
    </view>

    <view class="card list-card">
        <view class="price-row">
            <text class="detail-label">日薪</text>
            <text class="detail-strong">¥{{order.price}}</text>
        </view>
        <view class="price-row">
            <text class="detail-label">定金（30%）</text>
            <text class="detail-strong">¥{{order.deposit}}</text>
        </view>
        <text class="row-meta">商家支付定金后订单生效，服务完成后商家支付尾款 ¥{{order.price - order.deposit}}</text>
    </view>

    <block wx:if="{{order.status === 'pending'}}">
        <text wx:if="{{order.rescheduledAt}}" class="expired-hint">商家已把日期改至 {{dateLabel}}，请重新确认是否接单</text>
        <button class="btn-primary" loading="{{busy}}" disabled="{{busy}}" bindtap="accept">接单</button>
        <button class="btn-danger action-gap" loading="{{busy}}" disabled="{{busy}}" bindtap="reject">拒绝</button>
    </block>
    <view wx:else class="state-wrap">
        <text class="state-text">该订单已在订单消息中，可查看最新进展</text>
    </view>
</view>
