<view wx:if="{{authState === 'onboard'}}" class="state-wrap">
    <text class="state-text">先到首页选择身份并填写昵称</text>
    <view class="state-retry" bindtap="goHome">去首页</view>
</view>

<view wx:else class="main">
    <view class="card list-card profile-head">
        <view class="profile-avatar">
            <text>{{role === 'interpreter' ? '🎓' : '🏢'}}</text>
        </view>
        <view class="profile-info">
            <text class="row-title">{{name}}</text>
            <text class="row-sub">{{role === 'interpreter' ? '学生账号' : '企业账号'}}</text>
        </view>
    </view>

    <view wx:if="{{role === 'interpreter'}}" class="card list-card stats-card">
        <view class="stat-item">
            <text class="stat-num">{{pendingCount}}</text>
            <text class="stat-label">待接单</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
            <text class="stat-num">{{activeCount}}</text>
            <text class="stat-label">进行中</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
            <text class="stat-num">{{incomeTotal}}</text>
            <text class="stat-label">累计收入(¥)</text>
        </view>
    </view>

    <view class="menu-card card">
        <view class="menu-item" bindtap="goProfileEdit">
            <text class="menu-text">{{role === 'interpreter' ? '学生资料' : '企业资料'}}</text>
            <text class="menu-arrow">›</text>
        </view>
        <view wx:if="{{role === 'interpreter'}}" class="menu-item" bindtap="goAvailability">
            <text class="menu-text">空闲时间设置</text>
            <text class="menu-arrow">›</text>
        </view>
        <view wx:if="{{role === 'interpreter'}}" class="menu-item" bindtap="goIncome">
            <text class="menu-text">结算工资</text>
            <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="goOrders">
            <text class="menu-text">订单消息</text>
            <text class="menu-arrow">›</text>
        </view>
    </view>

    <view class="signout-bar">
        <text class="signout-text" bindtap="signOut">退出登录</text>
    </view>
</view>
