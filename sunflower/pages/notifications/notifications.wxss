.main {
    padding: 28rpx 32rpx 60rpx;
}

.state-retry {
    margin-top: 28rpx;
    padding: 0 44rpx;
    height: 72rpx;
    line-height: 72rpx;
    font-size: 26rpx;
    color: #c78d00;
    background: #fff3c4;
    border-radius: 36rpx;
}

.notice-actions {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 16rpx;
}

.notice-mark-all {
    font-size: 25rpx;
    color: #c78d00;
}

.notice-card {
    position: relative;
}

.notice-read {
    opacity: 0.62;
}

.notice-dot {
    width: 16rpx;
    height: 16rpx;
    background: #e11d48;
    border-radius: 50%;
    flex-shrink: 0;
}
